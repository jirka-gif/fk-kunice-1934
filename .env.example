# =============================================================================
#  FK KUNICE — proměnné prostředí
#  Zkopíruj tento soubor jako `.env.local` (lokální vývoj) a na Vercelu nastav
#  stejné klíče v Project Settings → Environment Variables.
# =============================================================================

# --- Databáze (Postgres) ---------------------------------------------------
# Když NENÍ nastavená, web funguje z výchozího obsahu (content/club.js) a změny
# se drží jen dočasně v paměti (pro rychlé lokální vyzkoušení).
# Na Vercelu ji získáš připojením Neon databáze z Marketplace (viz README-BACKEND.md).
# DATABASE_URL="postgres://uzivatel:heslo@host/dbname?sslmode=require"

# --- První správce administrace ---------------------------------------------
# Do /admin se přihlašuje e-mailem a heslem. Při úplně prvním spuštění se z těchto
# dvou proměnných založí účet správce; další uživatele pak zakládá on sám
# v sekci „Uživatelé a role". Po prvním přihlášení si heslo změň v administraci.
# (Bez nastavení platí admin@fkkunice.cz / "fkkunice" — jen pro lokální vývoj.)
ADMIN_EMAIL="spravce@fkkunice.cz"
ADMIN_PASSWORD="zmen-me-na-silne-heslo"

# Tajný klíč pro podpis přihlašovací cookie. Vygeneruj náhodný řetězec, např.:
#   openssl rand -base64 32
AUTH_SECRET="vygeneruj-nahodny-dlouhy-retezec"

# --- Automatické stahování zápasů z fotbal.cz -------------------------------
# Tajný klíč, kterým se scraper (GitHub Actions) hlásí na POST /api/matches.
# Stejnou hodnotu nastav i v repozitáři: Settings → Secrets → MATCHES_TOKEN,
# a k tomu SITE_URL s adresou nasazeného webu.
# Bez nastavení endpoint nikoho nepustí (návrhy zápasů se prostě nestahují).
MATCHES_TOKEN="vygeneruj-nahodny-dlouhy-retezec"

# --- Sociální sítě (Meta Graph API) ----------------------------------------
# Založení aplikace v Meta for Developers, propojení FB stránky a IG profilu
# a schválení oprávnění (pages_manage_posts, instagram_content_publish) dělá
# člověk ručně — v kódu je připravené všechno ostatní.
# Bez těchto proměnných se příspěvek prostě neodešle a v adminu se ukáže,
# co konkrétně chybí.
# META_PAGE_ID="id-facebookove-stranky-klubu"
# META_PAGE_TOKEN="dlouhodoby-token-stranky"
# META_IG_USER_ID="id-instagramoveho-business-uctu"
# META_GRAPH_VERSION="v21.0"

# Veřejná adresa webu — Meta si z ní stahuje vygenerovaný obrázek výsledku.
# SITE_URL="https://fkkunice.cz"

# --- Upozornění na poptávky pronájmu e-mailem -------------------------------
# Posílá se HTTP requestem přes Resend (https://resend.com), ne přes SMTP —
# Vercel má SMTP porty zavřené a nechtěli jsme kvůli tomu další závislost.
# Kam se posílá, se nastavuje v administraci (Pronájem → Otevírací doba).
# Bez těchto proměnných se e-mail neposílá; poptávka se do adminu uloží vždy.
# RESEND_API_KEY="re_..."
# MAIL_FROM="web@fkkunice.cz"
